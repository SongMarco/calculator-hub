---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROGRAMS, MEDIAN_INCOME_2026 } from '../../data/welfare.js';

function criterionText(p) {
  const t = p.income.type;
  if (t === 'none') return '소득 기준 없음';
  if (t === 'median') return `기준 중위소득 ${p.income.percent}% 이하`;
  return `연봉 ${p.income.amount.toLocaleString('ko-KR')}만원 이하`;
}
---
<BaseLayout
  title="내 연봉으로 찾는 정부 지원금 (2026)"
  description="연봉과 가구원 수를 입력하면 2026년 기준 받을 수 있는 정부 복지·지원금 11종을 골라드립니다. 부모급여, 청년월세, 근로장려금, 디딤돌대출 등 소득 기준 판정."
  keywords="정부 지원금 찾기, 내 연봉 지원금, 2026 복지 혜택, 청년월세 지원 조건, 근로장려금 조건"
  path="/welfare/"
>
  <p class="breadcrumb"><a href="/calculator-hub/">홈</a> &gt; 정부 지원금 찾기</p>
  <h1 class="page-title">내 연봉으로 찾는 정부 지원금 💰</h1>
  <p class="page-desc">연봉과 가구원 수를 입력하면 2026년 기준 받을 수 있는 정부 지원금만 골라드립니다.</p>
  <p class="updated">2026년 기준 중위소득(보건복지부 고시) 적용 · 최종 업데이트 2026-09-29</p>

  <section class="calc welfare-input">
    <h2>📝 내 정보 입력</h2>
    <div class="field">
      <label for="w-salary">세전 연봉 (만원)</label>
      <input id="w-salary" type="number" value="" min="0" placeholder="예: 3600" />
      <div class="hint">세전 총급여 기준. 상여금 포함 연봉을 입력하세요.</div>
    </div>
    <div class="field">
      <label>가구원 수</label>
      <div class="hh-btns" id="w-household">
        <button type="button" data-hh="1" class="active">1인</button>
        <button type="button" data-hh="2">2인</button>
        <button type="button" data-hh="3">3인</button>
        <button type="button" data-hh="4">4인 이상</button>
      </div>
      <div class="hint">4인 이상은 4인 가구 기준으로 계산됩니다.</div>
    </div>
    <label class="w-toggle">
      <input type="checkbox" id="w-only-ok" /> 받을 수 있는 것만 보기
    </label>
    <p class="note">소득 기준은 1차 판정용입니다. 실제 심사는 건강보험료·재산·가구 특성 등을 종합하므로 참고용으로만 활용하세요.</p>
  </section>

  <section class="w-list" id="w-list">
    <h2>🏛️ 정부 지원금 11종</h2>
    {PROGRAMS.map((p) => (
      <article
        class="w-card"
        data-type={p.income.type}
        data-percent={p.income.type === 'median' ? p.income.percent : ''}
        data-amount={p.income.type === 'salaryCap' ? p.income.amount : ''}
      >
        <div class="w-head">
          <h3>{p.name}</h3>
          <span class="w-badge w-neutral">연봉을 입력하세요</span>
        </div>
        <p class="w-criterion" data-base={criterionText(p)}>소득 기준: {criterionText(p)}</p>
        <p class="w-summary">{p.summary}</p>
        <dl class="gov-facts">
          <div><dt>대상</dt><dd>{p.target}</dd></div>
          <div><dt>지원 내용</dt><dd>{p.benefit}</dd></div>
        </dl>
        <p class="gov-desc">{p.desc}</p>
        {p.income.note && <p class="w-note">📌 {p.income.note}</p>}
        <a class="gov-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel} ↗</a>
      </article>
    ))}
  </section>

  <section class="article">
    <h2>2026년 기준 중위소득표 (월)</h2>
    <table class="rate">
      <tr><th>가구원 수</th><th>1인</th><th>2인</th><th>3인</th><th>4인</th></tr>
      <tr><td>중위소득 100%</td><td>256만원</td><td>420만원</td><td>536만원</td><td>649만원</td></tr>
    </table>
    <p>보건복지부 고시 기준이며, 원 단위 정확한 금액은 복지로에서 확인할 수 있습니다. 중위소득 기준 제도는 월 소득인정액(근로소득 공제·재산 환산을 반영한 금액)으로 심사하므로, 월급이 기준보다 조금 높아도 해당될 수 있습니다.</p>
    <h2>꼭 알아두세요</h2>
    <ul>
      <li>이 페이지의 판정은 <strong>소득 기준만</strong>으로 가린 1차 참고 결과입니다. 나이·무주택 여부·고용보험 가입기간 같은 다른 조건도 함께 충족해야 합니다.</li>
      <li>연봉은 세전 총급여 기준 근사치로 계산됩니다. 실제 심사는 건강보험료 납부액·재산 등을 종합합니다.</li>
      <li>제도는 매년 바뀌므로 신청 전 반드시 공식 사이트의 최신 공고를 확인하세요.</li>
    </ul>
    <p class="note">2026년 9월 기준이며, 실제 신청 조건은 공식 사이트에서 확인하세요.</p>
  </section>

  <script define:vars={{ median: MEDIAN_INCOME_2026 }}>
    const $ = (id) => document.getElementById(id);
    let household = 1;
    const salaryEl = $('w-salary');
    const listEl = $('w-list');
    const onlyOkEl = $('w-only-ok');

    document.querySelectorAll('#w-household button').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#w-household button').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        household = parseInt(btn.dataset.hh, 10);
        judge();
      });
    });
    salaryEl.addEventListener('input', judge);
    onlyOkEl.addEventListener('change', applyFilter);

    function capFor(card) {
      const type = card.dataset.type;
      if (type === 'median') {
        const pct = parseFloat(card.dataset.percent);
        const base = median[Math.min(household, 6)] || median[4];
        return { cap: Math.floor((base * pct) / 100 / 10000), label: `중위소득 ${pct}% 이하` };
      }
      if (type === 'salaryCap') {
        const amt = parseFloat(card.dataset.amount);
        return { cap: amt, label: `연봉 ${amt.toLocaleString('ko-KR')}만원 이하` };
      }
      return { cap: null, label: '소득 기준 없음' };
    }

    function judge() {
      const salary = parseFloat(String(salaryEl.value).replace(/,/g, '')) || 0;
      document.querySelectorAll('.w-card').forEach((card) => {
        const badge = card.querySelector('.w-badge');
        const crit = card.querySelector('.w-criterion');
        const { cap, label } = capFor(card);
        card.classList.remove('w-ok', 'w-dim');
        if (salary <= 0) {
          badge.className = 'w-badge w-neutral';
          badge.textContent = '연봉을 입력하세요';
          crit.textContent = `소득 기준: ${label}`;
          return;
        }
        if (cap === null) {
          badge.className = 'w-badge w-ok';
          badge.textContent = '받을 수 있어요';
          crit.textContent = `소득 기준: ${label} (다른 조건 확인 필요)`;
          card.classList.add('w-ok');
          return;
        }
        if (salary <= cap) {
          badge.className = 'w-badge w-ok';
          badge.textContent = '받을 수 있어요';
          crit.textContent = `소득 기준: ${label} → 연봉 약 ${cap.toLocaleString('ko-KR')}만원 이하 (${household === 4 ? '4인 이상' : household + '인'} 가구 기준)`;
          card.classList.add('w-ok');
        } else {
          badge.className = 'w-badge w-no';
          badge.textContent = '소득 기준 초과';
          crit.textContent = `소득 기준: ${label} → 연봉 약 ${cap.toLocaleString('ko-KR')}만원 이하 (${household === 4 ? '4인 이상' : household + '인'} 가구 기준)`;
          card.classList.add('w-dim');
        }
      });
      applyFilter();
    }

    function applyFilter() {
      const hide = onlyOkEl.checked;
      document.querySelectorAll('.w-card').forEach((card) => {
        card.style.display = hide && card.classList.contains('w-dim') ? 'none' : '';
      });
    }
  </script>
</BaseLayout>
