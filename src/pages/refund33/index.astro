---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { u } from '../../lib/paths.js';
import Faq from '../../components/Faq.astro';
import SourceNote from '../../components/SourceNote.astro';
import GovSupport from '../../components/GovSupport.astro';
import AdSlot from '../../components/AdSlot.astro';
import { AD_SLOTS } from '../../lib/ads.js';
import { faqJsonLd, pageUrl } from '../../lib/seo.js';

const faqs = [
  {
    q: '3.3%를 떼였는데 왜 또 세금을 내나요?',
    a: '3.3%는 원천징수로 미리 거둬간 예납금일 뿐, 실제 세금은 다음 해 5월 종합소득세 신고 때 확정됩니다. 필요경비를 제외한 소득금액에 세율을 적용한 결정세액이 이미 낸 3.3%보다 크면 추가로 납부하고, 적으면 환급받습니다.',
  },
  {
    q: '환급을 받으려면 어떻게 해야 하나요?',
    a: '다음 해 5월 종합소득세 신고 기간에 홈택스에서 신고해야 합니다. 필요경비 증빙(카드·계좌 내역, 간이영수증)을 모아두면 소득금액이 줄어들어 환급액이 커집니다. 신고하지 않으면 환급받을 수 없습니다.',
  },
  {
    q: '필요경비는 얼마나 인정되나요?',
    a: '실제 지출한 사업 관련 경비는 증빙이 있으면 인정됩니다. 장부를 쓰지 않는 경우 추계신고로 단순경비율(업종별 고시)을 적용할 수도 있습니다. 대표 업종코드 940909의 2025년 귀속 단순경비율은 64.1%입니다.',
  },
  {
    q: '이 계산 결과와 실제 환급액이 다를 수 있나요?',
    a: '네. 이 계산기는 세액공제(연금계좌·기부금 등)와 다른 소득(근로·기타소득)을 반영하지 않은 간이 계산입니다. 실제 신고 시에는 합산 소득과 각종 공제를 반영하므로 세무서·홈택스 모의계산으로 최종 확인하세요.',
  },
  {
    q: '홈택스에서 신고하면 끝인가요?',
    a: '아닙니다. 홈택스에서 종합소득세(국세) 신고를 마치면, 위택스에서 지방소득세 신고도 따로 해야 합니다. 지방소득세는 종합소득세 결정세액의 10%이며, 위택스 신고까지 마쳐야 정산이 완전히 끝납니다.',
  },
  {
    q: '작년에 신고를 못 했는데 지금이라도 환급받을 수 있나요?',
    a: '네. 법정 신고기한으로부터 5년 이내라면 경정청구로 소급해 환급받을 수 있습니다. 과거에 3.3%를 떼였는데 신고를 안 했다면, 홈택스에서 지급명세서를 확인하고 지금이라도 청구하세요.',
  },
  {
    q: '환급금은 언제 들어오나요?',
    a: '5월 정기 신고를 마치면 보통 6월 말~7월 초에 신고 시 등록한 환급계좌로 자동 입금됩니다. 홈택스 → 환급금 조회에서 진행 상황을 확인할 수 있습니다.',
  },
];
---
<BaseLayout
  title="프리랜서 3.3% 환급금 계산기"
  description="프리랜서 3.3% 원천징수 환급 예상액을 계산하세요. 종합소득세 신고 시 돌려받을 금액 미리보기."
  keywords="3.3% 환급금 계산기, 프리랜서 종합소득세 환급, 3.3% 돌려받기"
  path="/refund33/"
  ogImage="/images/card-refund33.webp"
  jsonLd={faqJsonLd(faqs, pageUrl("/refund33/"))}
>
  <p class="breadcrumb"><a href={u("/")}>홈</a> &gt; 3.3% 환급금 계산기</p>
  <h1 class="page-title">프리랜서 3.3% 환급금 계산기</h1>
  <p class="page-desc">1년간 번 돈과 쓴 경비를 입력하면 종합소득세 신고 때 돌려받을 환급 예상액을 계산해 드립니다.</p>
  <p class="updated">2026년 세율 기준 · 최종 업데이트 2026-09-30</p>

  <section class="calc">
    <h2>🧮 계산하기</h2>
    <div class="field">
      <label for="income">연간 사업소득 지급액 (만원, 세전)</label>
      <input id="income" type="number" inputmode="decimal" value="4000" min="0" />
      <div class="hint">1년간 받은 총액 (3.3% 떼기 전)</div>
    </div>
    <div class="field">
      <label for="expenses">필요경비 (만원)</label>
      <input id="expenses" type="number" inputmode="decimal" value="0" min="0" />
      <div class="hint">사업 관련 지출 증빙액. 모르면 0으로 두세요</div>
    </div>
    <div class="field">
      <label for="prepaid">이미 낸 세금 (만원, 3.3% 원천징수)</label>
      <input id="prepaid" type="number" inputmode="decimal" value="" min="0" placeholder="비워두면 자동 계산" />
      <div class="hint">지급액의 3.3%. 비워두면 자동 계산됩니다</div>
    </div>
    <div class="field">
      <label for="deduction">인적공제 (만원)</label>
      <input id="deduction" type="number" inputmode="decimal" value="150" min="0" />
      <div class="hint">본인 기본 150만원. 부양가족 있으면 추가</div>
    </div>
    <button class="btn" id="calc-btn">환급 예상액 계산하기</button>
    <button type="button" class="btn-share" id="share-btn">🔗 결과 링크 복사</button>
    <p class="share-msg" id="share-msg" role="status"></p>

    <div class="result" id="result">
      <div id="r-label">환급 예상액</div>
      <div class="big" id="r-refund">-</div>
      <table>
        <tr><th>항목</th><th>금액</th></tr>
        <tr><td>연간 사업소득</td><td id="r-income">-</td></tr>
        <tr><td>필요경비</td><td id="r-expenses">-</td></tr>
        <tr><td>소득금액</td><td id="r-taxable">-</td></tr>
        <tr><td>종합소득세 산출세액</td><td id="r-assessed">-</td></tr>
        <tr><td>이미 낸 세금 (3.3%)</td><td id="r-prepaid">-</td></tr>
      </table>
      <p class="note">세액공제·다른 소득은 반영하지 않은 간이 계산입니다. 실제 환급액은 5월 신고 시 확정됩니다.</p>
    </div>
  </section>

  <AdSlot slotId={AD_SLOTS.RESULT_BOTTOM} />

  <script>
    import { calcRefund33 } from '../../lib/refund33.js';
    import { initShareLink } from '../../lib/share.js';
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => Math.round(n).toLocaleString('ko-KR') + '원';
    const num = (id) => { const v = $(id).value.replace(/,/g, ''); return v === '' ? null : (parseFloat(v) || 0); };
    $('calc-btn').addEventListener('click', () => {
      const r = calcRefund33({
        income: (num('income') || 0) * 10000,
        expenses: (num('expenses') || 0) * 10000,
        prepaid: num('prepaid') == null ? null : num('prepaid') * 10000,
        personalDeduction: (num('deduction') || 0) * 10000,
      });
      $('r-label').textContent = r.isRefund ? '🎉 환급 예상액' : (r.refund === 0 ? '정산 결과' : '💸 추가 납부 예상액');
      $('r-refund').textContent = (r.refund < 0 ? '−' : '') + fmt(Math.abs(r.refund));
      $('r-income').textContent = fmt(r.income);
      $('r-expenses').textContent = fmt(r.expenses);
      $('r-taxable').textContent = fmt(r.taxableIncome);
      $('r-assessed').textContent = fmt(r.assessed);
      $('r-prepaid').textContent = fmt(r.prepaid);
      $('result').classList.add('show');
    });
    initShareLink();
  </script>

  <section class="article">
    <h2>3.3% 환급이 뭔가요?</h2>
    <div class="example-box"><strong>💡 예시로 이해하기</strong><br>1년에 2,400만원을 번 프리랜서가 단순경비율(64.1%)로 신고하면, 최종 세금은 약 43만원. 이미 3.3%로 약 79만원을 냈으니 약 37만원을 돌려받습니다.</div>
    <p>프리랜서에게 사업소득을 지급할 때 <strong>3.3%(소득세 3% + 지방소득세 0.3%)</strong>를 미리 떼고 줍니다. 이건 세금을 확정해서 걷는 게 아니라 <strong>예납</strong>입니다. 다음 해 5월 종합소득세 신고 때 필요경비를 뺀 실제 소득으로 세금을 다시 계산하고, 미리 낸 것보다 적으면 차액을 <strong>환급</strong>받습니다.</p>
    <div class="table-scroll"><table class="rate">
      <tr><th>구분</th><th>내용</th></tr>
      <tr><td>원천징수</td><td>지급액의 3.3% (예납)</td></tr>
      <tr><td>정산</td><td>다음 해 5월 종합소득세 신고</td></tr>
      <tr><td>환급 조건</td><td>결정세액 &lt; 기납부세액 (3.3%)</td></tr>
    </table></div>
    <h2>환급액을 늘리는 방법</h2>
    <ul>
      <li><strong>필요경비 증빙</strong>을 꼼꼼히 모으세요. 카드·계좌 이체 내역, 간이영수증이 모두 경비로 인정될 수 있습니다.</li>
      <li>장부를 쓰지 않으면 <strong>단순경비율</strong>로 추계신고할 수 있습니다 (업종별 고시율 적용).</li>
      <li>신고하지 않으면 환급받을 수 없습니다. 5월 신고 기간을 놓치지 마세요.</li>
    </ul>
  </section>

    <SourceNote date="2026년 9월" sources={["국세청 종합소득세 신고 안내"]} />

  <Faq items={faqs} />

  <GovSupport page="refund33" />

  <section class="related">
    <h2>관련 계산기</h2>
    <div class="grid">
      <a class="card" href={u("/freelancer/")}><h3>프리랜서 3.3% 계산기</h3><p>원천징수 후 실수령액</p></a>
      <a class="card" href={u("/expense-ratio/")}><h3>단순경비율 vs 기준경비율</h3><p>어떤 신고가 유리할까</p></a>
    </div>
  </section>
</BaseLayout>
