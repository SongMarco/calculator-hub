---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { u } from '../../lib/paths.js';
import Faq from '../../components/Faq.astro';
import GovSupport from '../../components/GovSupport.astro';
import AdSlot from '../../components/AdSlot.astro';
import { AD_SLOTS } from '../../lib/ads.js';
import { faqJsonLd, pageUrl } from '../../lib/seo.js';

const faqs = [
  {
    q: '단순경비율과 기준경비율은 뭐가 다른가요?',
    a: '둘 다 장부 없이 세금을 추계신고할 때 쓰는 경비율입니다. 단순경비율은 수입금액에 고시된 비율(업종별 60~90%)을 곱해 경비를 인정받고 증빙이 필요 없습니다. 기준경비율은 주요경비(매입·임차·인건비)는 증빙이 있어야 하고, 나머지만 고시된 비율(10~30%)로 인정받습니다. 세금 차이가 수백만원 날 수 있습니다.',
  },
  {
    q: '나는 단순경비율 대상인가요?',
    a: '직전연도 수입금액이 업종별 기준 미만이면 됩니다. 인적용역(프리랜서 대표 업종)은 3,600만원 미만, 전문·과학·기술·교육서비스업은 2,400만원 미만, 도소매업 등은 6,000만원 미만입니다. 당해연도 수입이 복식부기 의무 기준(인적용역 7,500만원 등)을 넘으면 기준경비율이 적용됩니다.',
  },
  {
    q: '기준경비율 대상자가 추계신고하면 불이익이 있나요?',
    a: '네. 기준경비율 대상자가 장부 없이 추계신고하면 단순경비율 대비 과세소득이 크게 늘어나고, 무기장 가산세(산출세액의 20%)가 붙을 수 있습니다. 이 경우 간편장부를 작성해 실제 경비를 인정받는 것이 유리한 경우가 많으니 세무 상담을 권장합니다.',
  },
  {
    q: '업종별 경비율은 어디서 확인하나요?',
    a: '국세청이 매년 고시합니다. 홈택스 → 조회/발급 → 경비율 조회에서 업종코드별 단순경비율·기준경비율을 확인할 수 있습니다. 대표적으로 프리랜서 업종코드 940909의 2025년 귀속 단순경비율은 64.1%, 기준경비율은 17.4%입니다.',
  },
  {
    q: '단순경비율 대상인데 간편장부를 쓰면 어떻게 되나요?',
    a: '쓸 수 있고, 실제 경비가 경비율보다 많다면 장부신고가 더 유리합니다. 반대로 기준경비율 대상자가 추계신고하면 세금폭탄 위험이 크므로, 간편장부를 작성해 실제 경비를 인정받는 것이 대부분 유리합니다.',
  },
  {
    q: '올해 처음 사업을 시작했는데 추계신고가 가능한가요?',
    a: '네. 신규사업자는 직전연도 수입이 없으므로 단순경비율로 추계신고할 수 있고, 무기장 가산세도 면제됩니다. 다만 당해연도 수입이 복식부기 의무 기준을 넘으면 기준경비율이 적용되니 주의하세요.',
  },
  {
    q: '이 계산기로 알 수 없는 것은 뭔가요?',
    a: '종합소득세만 비교하며, 건강보험료·국민연금 지역가입자 보험료는 반영하지 않습니다. 기준경비율로 소득금액이 커지면 건보료도 함께 오르는 점은 세무 상담으로 확인하세요.',
  },
];
---
<BaseLayout
  title="단순경비율 vs 기준경비율 계산기"
  description="종합소득세 추계신고 시 단순경비율과 기준경비율 중 어느 쪽이 유리한지 비교하세요. 2026년 신고 기준."
  keywords="단순경비율 기준경비율 계산기, 단순경비율 계산, 추계신고 비교"
  path="/expense-ratio/"
  ogImage="/images/card-expense-ratio.webp"
  jsonLd={faqJsonLd(faqs, pageUrl("/expense-ratio/"))}
>
  <p class="breadcrumb"><a href={u("/")}>홈</a> &gt; 단순경비율 vs 기준경비율 계산기</p>
  <h1 class="page-title">단순경비율 vs 기준경비율 계산기</h1>
  <p class="page-desc">수입금액과 경비율을 입력하면 두 가지 추계신고(장부 없이 세금을 어림잡아 신고하는 방식)의 소득금액·예상 세액을 비교해 드립니다.</p>
  <p class="updated">2026년 세율 기준 · 최종 업데이트 2026-09-30</p>

  <section class="calc">
    <h2>🧮 계산하기</h2>
    <div class="field">
      <label for="revenue">연간 수입금액 (만원)</label>
      <input id="revenue" type="number" inputmode="decimal" value="4000" min="0" />
    </div>
    <div class="field">
      <label for="preset">업종 프리셋 (2025년 귀속)</label>
      <select id="preset">
        <option value="64.1|17.4" selected>940909 인적용역(프리랜서 대표): 64.1% / 17.4%</option>
        <option value="custom">직접 입력</option>
      </select>
      <div class="hint">내 업종코드의 경비율은 홈택스에서 조회하세요</div>
    </div>
    <div class="field">
      <label for="simpleRate">단순경비율 (%)</label>
      <input id="simpleRate" type="number" inputmode="decimal" value="64.1" min="0" max="100" step="0.1" />
    </div>
    <div class="field">
      <label for="standardRate">기준경비율 (%)</label>
      <input id="standardRate" type="number" inputmode="decimal" value="17.4" min="0" max="100" step="0.1" />
    </div>
    <div class="field">
      <label for="docExp">주요경비 증빙액 (만원)</label>
      <input id="docExp" type="number" inputmode="decimal" value="500" min="0" />
      <div class="hint">기준경비율 계산용: 매입·임차·인건비 등 증빙 있는 금액</div>
    </div>
    <div class="field">
      <label for="prevRevenue">직전연도 수입금액 (만원)</label>
      <input id="prevRevenue" type="number" inputmode="decimal" value="3000" min="0" />
      <div class="hint">인적용역 기준 3,600만원 미만이면 단순경비율 적용 가능</div>
    </div>
    <button class="btn" id="calc-btn">비교하기</button>
    <button type="button" class="btn-share" id="share-btn">🔗 결과 링크 복사</button>
    <p class="share-msg" id="share-msg" role="status"></p>

    <div class="result" id="result">
      <div id="r-verdict">-</div>
      <table>
        <tr><th>구분</th><th>단순경비율</th><th>기준경비율</th></tr>
        <tr><td>필요경비</td><td id="r-s-exp">-</td><td id="r-t-exp">-</td></tr>
        <tr><td>소득금액</td><td id="r-s-inc">-</td><td id="r-t-inc">-</td></tr>
        <tr><td>예상 종합소득세</td><td id="r-s-tax">-</td><td id="r-t-tax">-</td></tr>
      </table>
      <p class="note" id="r-note"></p>
    </div>
  </section>

  <AdSlot slotId={AD_SLOTS.RESULT_BOTTOM} />

  <script>
    import { calcExpenseRatio } from '../../lib/expense-ratio.js';
    import { initShareLink } from '../../lib/share.js';
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => Math.round(n).toLocaleString('ko-KR') + '원';
    const num = (id) => parseFloat($(id).value.replace(/,/g, '')) || 0;
    $('preset').addEventListener('change', () => {
      const v = $('preset').value;
      if (v !== 'custom') {
        const [s, t] = v.split('|');
        $('simpleRate').value = s;
        $('standardRate').value = t;
      }
    });
    $('calc-btn').addEventListener('click', () => {
      const r = calcExpenseRatio({
        revenue: num('revenue') * 10000,
        simpleRate: num('simpleRate'),
        standardRate: num('standardRate'),
        documentedExpenses: num('docExp') * 10000,
        prevRevenue: num('prevRevenue') * 10000,
      });
      $('r-verdict').innerHTML = r.simpleBetter
        ? '<div class="big">단순경비율이 유리해요 🎉</div>'
        : '<div class="big">기준경비율(또는 장부신고)을 검토하세요</div>';
      $('r-s-exp').textContent = fmt(r.simple.expenses);
      $('r-t-exp').textContent = fmt(r.standard.expenses);
      $('r-s-inc').textContent = fmt(r.simple.income);
      $('r-t-inc').textContent = fmt(r.standard.income);
      $('r-s-tax').textContent = fmt(r.simple.tax);
      $('r-t-tax').textContent = fmt(r.standard.tax);
      $('r-note').textContent = r.simpleEligible
        ? '직전연도 수입 기준으로 단순경비율 적용이 가능합니다. 세액은 소득공제 150만원 가정 간이 계산입니다.'
        : '직전연도 수입이 기준을 초과해 단순경비율 적용이 어렵습니다. 기준경비율 추계보다 간편장부 작성이 유리할 수 있으니 세무 상담을 권장합니다.';
      $('result').classList.add('show');
    });
    initShareLink();
  </script>

  <section class="article">
    <h2>경비율 추계신고란?</h2>
    <div class="example-box"><strong>💡 예시로 이해하기</strong><br>프리랜서(940909)가 연 4,000만원을 벌었다면? 단순경비율(64.1%) 적용 시 세금은 약 77만원, 기준경비율(17.4%) 적용 시 약 347만원입니다. 신고 방식 하나에 약 270만원이 갈립니다.</div>
    <p>장부를 작성하지 않은 소규모 사업자가 종합소득세를 신고할 때, 국세청이 정한 <strong>경비율</strong>을 적용해 필요경비를 추계하는 방식입니다. 경비율 종류에 따라 인정받는 경비가 크게 달라집니다.</p>
    <div class="table-scroll"><table class="rate">
      <tr><th>구분</th><th>단순경비율</th><th>기준경비율</th></tr>
      <tr><td>경비 인정</td><td>수입 × 고시율 (증빙 불필요)</td><td>주요경비 증빙 + 수입 × 고시율</td></tr>
      <tr><td>고시율 수준</td><td>업종별 60~90%</td><td>업종별 10~30%</td></tr>
      <tr><td>적용 대상</td><td>직전연도 수입이 업종별 기준 미만</td><td>그 외 추계신고자</td></tr>
    </table></div>
    <h2>단순경비율 적용 기준 (직전연도 수입금액)</h2>
    <ul>
      <li><strong>인적용역</strong>(프리랜서 등): 3,600만원 미만</li>
      <li><strong>전문·과학·기술·교육서비스업</strong>: 2,400만원 미만</li>
      <li><strong>도소매업 등</strong>: 6,000만원 미만</li>
    </ul>
    <p class="note">당해연도 수입이 복식부기 의무 기준(인적용역 7,500만원 등)을 넘으면 기준경비율이 적용됩니다.</p>
  </section>

  <Faq items={faqs} />

  <GovSupport page="expense-ratio" />

  <section class="related">
    <h2>관련 계산기</h2>
    <div class="grid">
      <a class="card" href={u("/freelancer/")}><h3>프리랜서 3.3% 계산기</h3><p>원천징수 후 실수령액</p></a>
      <a class="card" href={u("/refund33/")}><h3>3.3% 환급금 계산기</h3><p>돌려받을 금액 미리보기</p></a>
    </div>
  </section>
</BaseLayout>
