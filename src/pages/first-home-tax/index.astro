---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { u } from '../../lib/paths.js';
import Faq from '../../components/Faq.astro';
import GovSupport from '../../components/GovSupport.astro';
import AdSlot from '../../components/AdSlot.astro';
import { AD_SLOTS } from '../../lib/ads.js';
import { faqJsonLd, pageUrl } from '../../lib/seo.js';

const faqs = [
  {
    q: '생애최초 취득세 감면 대상은 누구인가요?',
    a: '본인과 배우자 모두 과거에 주택을 소유한 사실이 없어야 하고, 실거래가 12억원 이하인 주택을 유상(매매)으로 취득해야 합니다. 상속·증여로 취득한 경우는 대상이 아닙니다.',
  },
  {
    q: '얼마까지 감면되나요?',
    a: '산출된 취득세에서 최대 200만원까지 차감됩니다. 2026년부터 인구감소지역에서 생애최초로 주택을 구입하면 한도가 300만원으로 확대됩니다. 40세 미만 청년 300만원 확대와 주거용 오피스텔 포함은 2026년 지방세제 개편안(입법예고 단계)으로 아직 확정되지 않았습니다.',
  },
  {
    q: '2026년에 전입 요건이 바뀌었다던데요?',
    a: '2026년 1월 1일부터 기존의 ‘3개월 이내 전입’ 요건이 삭제됐습니다. 대신 취득일부터 3년 안에 매각·증여하거나 임대 등 다른 용도로 사용하면 감면받은 세액을 추징합니다. 본인이 거주할 목적으로 취득해야 한다는 점은 그대로입니다.',
  },
  {
    q: '신청 기한이 있나요?',
    a: '취득일(잔금 지급일)로부터 60일 이내에 취득세 신고·납부 시 감면 신청서를 함께 제출해야 합니다. 기한을 넘기면 감면을 받을 수 없으니 잔금 전에 미리 준비하세요.',
  },
];
---
<BaseLayout
  title="생애최초 취득세 감면 계산기"
  description="생애 첫 주택 구입 시 취득세 감면액(최대 200만원, 인구감소지역 300만원)을 계산하세요. 2026년 기준."
  keywords="생애최초 취득세 감면 계산기, 첫 주택 취득세 계산, 생애최초 감면 한도"
  path="/first-home-tax/"
  ogImage="/images/card-first-home-tax.webp"
  jsonLd={faqJsonLd(faqs, pageUrl("/first-home-tax/"))}
>
  <p class="breadcrumb"><a href={u("/")}>홈</a> &gt; 생애최초 취득세 감면 계산기</p>
  <h1 class="page-title">생애최초 취득세 감면 계산기</h1>
  <p class="page-desc">취득가액을 입력하면 생애최초 감면 적용 후 실제 납부할 취득세를 계산해 드립니다.</p>
  <p class="updated">2026년 세율 기준 · 최종 업데이트 2026-09-30</p>

  <section class="calc">
    <h2>🧮 계산하기</h2>
    <div class="field">
      <label for="price">취득가액 (만원, 실거래가)</label>
      <input id="price" type="number" value="30000" min="0" />
      <div class="hint">매매계약서상 실거래가 기준</div>
    </div>
    <div class="field">
      <label>생애최초 해당 여부</label>
      <div class="radio-row">
        <label><input type="radio" name="first" value="y" checked /> 해당 (본인·배우자 모두 무주택)</label>
        <label><input type="radio" name="first" value="n" /> 미해당</label>
      </div>
    </div>
    <div class="field">
      <label>인구감소지역 여부</label>
      <div class="radio-row">
        <label><input type="radio" name="depop" value="n" checked /> 아니오 (한도 200만원)</label>
        <label><input type="radio" name="depop" value="y" /> 예 (한도 300만원)</label>
      </div>
    </div>
    <button class="btn" id="calc-btn">납부세액 계산하기</button>

    <div class="result" id="result">
      <div>감면 후 납부세액</div>
      <div class="big" id="r-payable">-</div>
      <table>
        <tr><th>항목</th><th>금액</th></tr>
        <tr><td>취득가액</td><td id="r-price">-</td></tr>
        <tr><td>적용 취득세율</td><td id="r-rate">-</td></tr>
        <tr><td>취득세</td><td id="r-acq">-</td></tr>
        <tr><td>지방교육세</td><td id="r-edu">-</td></tr>
        <tr><td>생애최초 감면액</td><td id="r-reduction">-</td></tr>
      </table>
      <p class="note" id="r-note"></p>
    </div>
  </section>

  <AdSlot slotId={AD_SLOTS.RESULT_BOTTOM} />

  <script>
    import { calcFirstHomeTax } from '../../lib/first-home-tax.js';
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => Math.round(n).toLocaleString('ko-KR') + '원';
    const num = (id) => parseFloat($(id).value.replace(/,/g, '')) || 0;
    const checked = (name) => document.querySelector(`input[name="${name}"]:checked`).value;
    $('calc-btn').addEventListener('click', () => {
      const r = calcFirstHomeTax({
        price: num('price') * 10000,
        isFirstTimer: checked('first') === 'y',
        isDepopulated: checked('depop') === 'y',
      });
      $('r-payable').textContent = fmt(r.payable);
      $('r-price').textContent = fmt(r.price);
      $('r-rate').textContent = r.rate + '%';
      $('r-acq').textContent = fmt(r.acqTax);
      $('r-edu').textContent = fmt(r.eduTax);
      $('r-reduction').textContent = r.reduction > 0 ? '−' + fmt(r.reduction) : '해당 없음';
      $('r-note').textContent = r.overLimit
        ? '취득가액이 12억원을 초과하면 생애최초 감면 대상이 아닙니다.'
        : (r.eligible
          ? `감면 한도 ${fmt(r.cap)} 중 ${fmt(r.reduction)}이 차감됩니다. 농어촌특별세는 서민주택 감면 시 비과세입니다.`
          : '생애최초에 해당하지 않으면 감면 없이 전액 납부합니다.');
      $('result').classList.add('show');
    });
  </script>

  <section class="article">
    <h2>생애최초 취득세 감면이란?</h2>
    <p>태어나서 처음으로 주택을 사는 사람의 취득세 부담을 덜어주는 지방세 제도입니다. <strong>산출된 취득세에서 최대 200만원</strong>(인구감소지역은 2026년부터 300만원)을 차감해 줍니다.</p>
    <table class="rate">
      <tr><th>구분</th><th>내용</th></tr>
      <tr><td>대상</td><td>본인·배우자 모두 주택 소유 이력 없음</td></tr>
      <tr><td>주택 가액</td><td>실거래가 12억원 이하</td></tr>
      <tr><td>취득 방식</td><td>유상 취득 (상속·증여 제외)</td></tr>
      <tr><td>감면 한도</td><td>200만원 (인구감소지역 300만원)</td></tr>
      <tr><td>신청 기한</td><td>취득일로부터 60일 이내</td></tr>
    </table>
    <h2>꼭 알아두세요</h2>
    <ul>
      <li>2026년 1월 1일부터 ‘3개월 이내 전입’ 요건이 삭제됐습니다. 대신 <strong>취득일부터 3년 안에 매각·증여·임대</strong>하면 감면세액을 추징합니다.</li>
      <li>과거에 집을 소유했다가 처분해 현재 무주택이어도 생애최초로 인정되지 않습니다.</li>
      <li>40세 미만 청년 300만원 확대와 주거용 오피스텔 포함은 2026년 지방세제 개편안(입법예고)으로 아직 확정되지 않았습니다.</li>
      <li>서민주택 감면 시 농어촌특별세는 비과세이며, 지방교육세는 취득세액의 10%가 함께 계산됩니다.</li>
    </ul>
  </section>

  <AdSlot slotId={AD_SLOTS.IN_CONTENT} />

  <Faq items={faqs} />

  <GovSupport page="first-home-tax" />

  <section class="related">
    <h2>관련 계산기</h2>
    <div class="grid">
      <a class="card" href={u("/dsr/")}><h3>DSR 계산기</h3><p>주택담보대출 한도 확인</p></a>
      <a class="card" href={u("/monthly-rent/")}><h3>월세 세액공제 계산기</h3><p>연 1,000만원 한도</p></a>
    </div>
  </section>
</BaseLayout>
