---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { u } from '../../lib/paths.js';
import Faq from '../../components/Faq.astro';
import GovSupport from '../../components/GovSupport.astro';
import AdSlot from '../../components/AdSlot.astro';
import { AD_SLOTS } from '../../lib/ads.js';
import { faqJsonLd, pageUrl } from '../../lib/seo.js';

const faqs = [
  {
    q: '3.3%를 떼면 세금이 끝난 건가요?',
    a: '아닙니다. 3.3%는 원천징수로 미리 거둬가는 것이고, 다음 해 5월 종합소득세 신고 때 실제 소득에 맞춰 정산합니다. 필요경비를 제외한 소득이 적었다면 환급받을 수 있습니다.',
  },
  {
    q: '3.3%는 누가 떼나요?',
    a: '사업소득을 지급하는 사업자(원천징수의무자)가 지급액에서 3.3%를 떼고 국세청에 납부합니다. 프리랜서가 직접 떼는 게 아니라, 돈을 주는 쪽에서 처리합니다.',
  },
  {
    q: '사업자등록을 하면 3.3%가 달라지나요?',
    a: '사업자등록 여부와 무관하게 사업소득 지급 시 3.3% 원천징수는 동일합니다. 다만 간이과세자·일반과세자는 부가가치세(10%)를 별도로 청구할 수 있습니다.',
  },
  {
    q: '환급은 얼마나 받을 수 있나요?',
    a: '필요경비율이 높거나 다른 소득이 없어 종합소득세 결정세액이 원천징수액보다 적으면 차액을 환급받습니다. 경비 증빙(카드·계좌 내역, 간이영수증)을 잘 모아두는 게 핵심입니다.',
  },
  {
    q: '직장을 그만두고 프리랜서가 되면 건강보험료가 어떻게 되나요?',
    a: '직장가입자에서 지역가입자로 바뀌어 보험료 전액을 본인이 부담합니다. 소득·재산 기준으로 산정돼 직장 다닐 때보다 크게 오를 수 있으니 국민건강보험공단 모의계산으로 미리 확인하세요. 퇴직 후 최대 3년까지 직장가입자 수준 보험료를 유지하는 임의계속가입을 신청할 수도 있습니다.',
  },
  {
    q: '환급금은 언제 들어오나요?',
    a: '5월에 종합소득세 신고를 마치면 보통 6월 말~7월 초에 환급 계좌로 입금됩니다. 종합소득세(국세)가 먼저 들어오고, 약 일주일 뒤 지방소득세가 별도로 입금됩니다.',
  },
  {
    q: '직장도 다니면서 프리랜서 일을 하면 세금은 어떻게 되나요?',
    a: '회사의 근로소득(연말정산 완료분)과 프리랜서 사업소득을 합산해 다음 해 5월 종합소득세로 다시 정산합니다. 합산 소득이 늘면 세율 구간이 올라가 추가 납부가 생길 수도 있고, 경비가 많으면 환급이 늘어날 수도 있습니다.',
  },
];
---
<BaseLayout
  title="프리랜서 3.3% 계산기"
  description="프리랜서 사업소득 3.3% 원천징수(소득세 3% + 지방소득세 0.3%) 후 실제 수령액을 계산하세요."
  keywords="프리랜서 3.3% 계산기, 사업소득 원천징수, 3.3% 세금 계산"
  path="/freelancer/"
  ogImage="/images/card-freelancer.webp"
  jsonLd={faqJsonLd(faqs, pageUrl("/freelancer/"))}
>
  <p class="breadcrumb"><a href={u("/")}>홈</a> &gt; 프리랜서 3.3% 계산기</p>
  <h1 class="page-title">프리랜서 3.3% 계산기</h1>
  <p class="page-desc">지급액을 입력하면 3.3% 원천징수를 뗀 실제 수령액을 계산해 드립니다.</p>
  <p class="updated">2026년 세율 기준 · 최종 업데이트 2026-09-28</p>

  <section class="calc">
    <h2>🧮 계산하기</h2>
    <div class="field">
      <label for="payment">지급액 (만원, 세전)</label>
      <input id="payment" type="number" inputmode="decimal" value="300" min="0" />
      <div class="hint">계약서상 총 지급액 기준</div>
    </div>
    <button class="btn" id="calc-btn">실수령액 계산하기</button>
    <button type="button" class="btn-share" id="share-btn">🔗 결과 링크 복사</button>
    <p class="share-msg" id="share-msg" role="status"></p>

    <div class="result" id="result">
      <div>실수령액</div>
      <div class="big" id="r-net">-</div>
      <table>
        <tr><th>항목</th><th>금액</th></tr>
        <tr><td>지급액 (세전)</td><td id="r-payment">-</td></tr>
        <tr><td>원천징수 소득세 (3%)</td><td id="r-income">-</td></tr>
        <tr><td>원천징수 지방소득세 (0.3%)</td><td id="r-local">-</td></tr>
        <tr><td>원천징수 합계 (3.3%)</td><td id="r-withholding">-</td></tr>
      </table>
      <p class="note">필요경비를 제외한 금액이 과세 기준이지만, 이 계산기는 지급액 전체 기준 간이 계산입니다. 종합소득세 신고 시 정산됩니다.</p>
    </div>
  </section>

  <AdSlot slotId={AD_SLOTS.RESULT_BOTTOM} />

  <script>
    import { calcFreelancer } from '../../lib/freelancer.js';
    import { initShareLink } from '../../lib/share.js';
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => Math.round(n).toLocaleString('ko-KR') + '원';
    const num = (id) => parseFloat($(id).value.replace(/,/g, '')) || 0;
    $('calc-btn').addEventListener('click', () => {
      const r = calcFreelancer({ payment: num('payment') * 10000 });
      $('r-net').textContent = fmt(r.net);
      $('r-payment').textContent = fmt(r.payment);
      $('r-income').textContent = fmt(r.incomeTax);
      $('r-local').textContent = fmt(r.localTax);
      $('r-withholding').textContent = fmt(r.withholding);
      $('result').classList.add('show');
    });
    initShareLink();
  </script>

  <section class="article">
    <h2>3.3%가 뭔가요?</h2>
    <p>사업소득을 지급할 때 원천징수되는 세율입니다. <strong>소득세 3% + 지방소득세 0.3%</strong>로 구성됩니다. 돈을 주는 사업자가 지급액에서 미리 떼고 국세청에 납부합니다.</p>
    <div class="table-scroll"><table class="rate">
      <tr><th>구분</th><th>세율</th></tr>
      <tr><td>소득세</td><td>3%</td></tr>
      <tr><td>지방소득세</td><td>0.3%</td></tr>
      <tr><td>합계</td><td><strong>3.3%</strong></td></tr>
    </table></div>
    <h2>꼭 알아두세요</h2>
    <ul>
      <li>3.3%는 <strong>예납</strong> 개념입니다. 다음 해 5월 종합소득세 신고 때 필요경비를 반영해 정산하고, 더 냈다면 환급받습니다.</li>
      <li>필요경비는 장부·증빙이 있어야 인정됩니다. 카드·계좌 이체 내역을 모아두세요.</li>
      <li>연 소득 2,400만원 이하 등 소액 사업자는 추계신고(단순경비율)도 가능합니다.</li>
    </ul>
    <div class="example-box"><strong>💡 예시로 이해하기</strong><br>계약서상 지급액이 300만원이라면 원천징수 3.3%(99,000원)를 뗀 2,901,000원이 입금됩니다. 이 99,000원은 세금을 미리 낸 것(예납)으로, 다음 해 5월 종합소득세 신고 때 필요경비를 인정받으면 일부 또는 전부를 돌려받을 수 있습니다.</div>
  </section>

  <Faq items={faqs} />

  <GovSupport page="freelancer" />

  <section class="related">
    <h2>관련 계산기</h2>
    <div class="grid">
      <a class="card" href={u("/refund33/")}><h3>3.3% 환급금 계산기</h3><p>종합소득세 신고 때 돌려받기</p></a>
      <a class="card" href={u("/expense-ratio/")}><h3>단순경비율 vs 기준경비율</h3><p>어떤 신고가 유리할까</p></a>
    </div>
  </section>
</BaseLayout>
