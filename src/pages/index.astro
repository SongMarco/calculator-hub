---
import BaseLayout from '../layouts/BaseLayout.astro';
import { u } from '../lib/paths.js';

const IMG = u('/images');
const calculators = [
  {
    href: u('/salary/'), tag: '2026년 최신 요율', img: `${IMG}/card-salary.webp`,
    title: '연봉 실수령액 계산기',
    desc: '국민연금 4.75%·건강보험 3.595% 등 2026년 요율로 내 월급 실수령액을 계산해 보세요.',
  },
  {
    href: u('/severance/'), tag: '세후 금액까지', img: `${IMG}/card-severance.webp`,
    title: '퇴직금 계산기',
    desc: '평균임금·근속연수로 세전 퇴직금을 구하고, 퇴직소득세를 뗀 세후 실수령액까지 확인하세요.',
  },
  {
    href: u('/parttime-severance/'), tag: '주휴수당 포함', img: `${IMG}/card-parttime-severance.webp`,
    title: '알바 퇴직금 계산기',
    desc: '시급·주당 근무시간만 입력하면 수급 자격부터 주휴수당 포함 예상 퇴직금까지 계산합니다.',
  },
  {
    href: u('/unemployment/'), tag: '2026년 상한 68,100원', img: `${IMG}/card-unemployment.webp`,
    title: '실업급여(구직급여) 계산기',
    desc: '평균임금의 60%·지급일수 120~270일로 퇴직 후 받을 예상 수령액을 계산하세요.',
  },
  {
    href: u('/freelancer/'), tag: '원천징수 3.3%', img: `${IMG}/card-freelancer.webp`,
    title: '프리랜서 3.3% 계산기',
    desc: '사업소득 3.3% 원천징수 후 실제로 통장에 들어오는 금액을 바로 계산합니다.',
  },
  {
    href: u('/parental/'), tag: '2026년 개편 반영', img: `${IMG}/card-parental.webp`,
    title: '육아휴직 급여 계산기',
    desc: '1~3개월 최대 250만원 등 2026년 지급 기준으로 휴직 기간별 예상 급여를 계산하세요.',
  },
  {
    href: u('/dsr/'), tag: '스트레스 DSR', img: `${IMG}/card-dsr.webp`,
    title: 'DSR·스트레스 DSR 계산기',
    desc: '내 대출의 DSR과 스트레스 금리를 적용한 DSR을 구해 대출 한도 가능 여부를 가늠해 보세요.',
  },
  {
    href: u('/monthly-rent/'), tag: '연 1,000만원 한도', img: `${IMG}/card-monthly-rent.webp`,
    title: '월세 세액공제 계산기',
    desc: '2026년 공제율 17%·15%로 내 월세 환급액을 계산해 보세요. 총급여 구간별 한도를 바로 확인합니다.',
  },
  {
    href: u('/yearend-tax/'), tag: '환급 미리보기', img: `${IMG}/card-yearend-tax.webp`,
    title: '연말정산 미리보기 계산기',
    desc: '총급여·인적공제·연금계좌로 2026년 연말정산 환급 예상액을 미리 계산하세요.',
  },
  {
    href: u('/national-pension/'), tag: '노령연금 예상', img: `${IMG}/card-national-pension.webp`,
    title: '국민연금 예상수령액 계산기',
    desc: '가입기간·월 평균소득으로 2026년 기준 노령연금 월 수령액을 계산하세요.',
  },
  {
    href: u('/rent-conversion/'), tag: '법정 상한 확인', img: `${IMG}/card-rent-conversion.webp`,
    title: '전월세 전환율 계산기',
    desc: '보증금을 월세로·월세를 보증금으로 바꿀 때 적정 금액을 계산하고 법정 상한을 확인하세요.',
  },
  {
    href: u('/irp/'), tag: '일시금 vs 연금', img: `${IMG}/card-irp.webp`,
    title: 'IRP 세금 비교 계산기',
    desc: '퇴직금을 한 번에 받을 때와 연금으로 나눠 받을 때의 세금 차이를 비교해 절세액을 확인하세요.',
  },
  {
    href: u('/avg-down/'), tag: '목표 평단가 역계산', img: `${IMG}/og-hub.webp`,
    title: '주식 물타기 계산기',
    desc: '추가 매수 시 낮아지는 평단가·인하율을 계산하고, 목표 평단가에 필요한 매수 수량을 역산해 보세요.',
  },
  {
    href: u('/coupang-night/'), tag: '근무조별 일급', img: `${IMG}/card-overtime.webp`,
    title: '쿠팡 야간 일급 계산기',
    desc: '쿠팡 물류센터 주간·오후·심야·완전야간조 중 어디가 돈이 되는지 야간수당 포함 일급으로 비교해 보세요.',
  },
  {
    href: u('/hourly-wage/'), tag: '2026년 10,320원', img: `${IMG}/card-hourly-wage.webp`,
    title: '주휴 포함 시급 계산기',
    desc: '주휴수당을 포함한 세전 월급과 실질 시급을 계산해 보세요. 최저임금 미달 여부도 체크합니다.',
  },
  {
    href: u('/overtime/'), tag: '연장·야간·휴일', img: `${IMG}/card-overtime.webp`,
    title: '연장·야간·휴일 수당 계산기',
    desc: '연장·야간 50% 가산, 휴일 8시간 초과 100% 가산으로 시간외 수당을 항목별로 계산하세요.',
  },
  {
    href: u('/first-home-tax/'), tag: '최대 200만원 감면', img: `${IMG}/card-first-home-tax.webp`,
    title: '생애최초 취득세 감면 계산기',
    desc: '생애 첫 주택 구입 시 취득세 감면액을 계산해 보세요. 2026년 기준 12억원 이하·인구감소지역 300만원 반영.',
  },
  {
    href: u('/refund33/'), tag: '5월 신고 대비', img: `${IMG}/card-refund33.webp`,
    title: '3.3% 환급금 계산기',
    desc: '프리랜서 3.3% 원천징수, 종합소득세 신고 때 얼마나 돌려받을지 미리 계산해 보세요.',
  },
  {
    href: u('/expense-ratio/'), tag: '추계신고 비교', img: `${IMG}/card-expense-ratio.webp`,
    title: '단순경비율 vs 기준경비율 계산기',
    desc: '종합소득세 추계신고, 단순경비율과 기준경비율 중 어느 쪽이 유리한지 비교해 보세요.',
  },
  {
    href: u('/welfare/'), tag: '소득 기준 판정', img: `${IMG}/og-welfare.webp`,
    title: '내 연봉으로 찾는 정부 지원금',
    desc: '연봉 구간 피라미드에서 내 구간을 누르면 받을 수 있는 정부 복지·지원금 11종을 골라드립니다.',
  },
];

const upcoming = [
  '알바 퇴직금 계산기',
];
---
<BaseLayout
  title="돈 계산, 쉽게"
  description="2026년 최신 요율을 반영한 연봉 실수령액, 퇴직금, 프리랜서 3.3%, 육아휴직 급여, DSR, 월세 세액공제, IRP 세금 비교, 주휴 포함 시급 계산기를 한 곳에 모았습니다."
  keywords="연봉 실수령액 계산기, 퇴직금 계산기, 프리랜서 3.3%, 육아휴직 급여, DSR 계산기, 월세 세액공제 계산기, IRP 세금 비교, 주휴수당 계산기"
>
  <section class="hero-panel">
    <div class="hero-copy">
      <span class="hero-eyebrow">✨ 2026년 최신 요율 반영</span>
      <h1>돈 계산, 쉽게.</h1>
      <p class="lead">복잡한 공식은 저희가, 결과만 가져가세요. 급여·세금·대출 계산기와 내 연봉으로 찾을 수 있는 정부 지원금까지 한 곳에 모았습니다.</p>
      <div class="hero-ctas">
        <a class="btn-light" href="#calculators">계산기 보기 ↓</a>
        <a class="btn-outline-light" href={u("/welfare/")}>💰 정부 지원금 찾기</a>
      </div>
      <div class="trust-row">
        <span class="chip">✓ 공식 출처 기준</span>
        <span class="chip">✓ 단위 테스트 검증</span>
        <span class="chip">✓ 무료 · 회원가입 없음</span>
      </div>
    </div>
    <div class="hero-media">
      <img src={`${IMG}/og-hub.webp`} alt="계산기와 동전, 차트 일러스트" width="1200" height="630" fetchpriority="high" />
    </div>
  </section>

  <div class="section-head" id="calculators">
    <span class="eyebrow">CALCULATORS</span>
    <h2>필요한 계산기를 골라보세요</h2>
    <p>2026년 요율 기준 · 결과는 참고용 추정치입니다</p>
  </div>
  <div class="grid">
    {calculators.map((c) => (
      <a class="card" href={c.href}>
        <div class="card-media"><img src={c.img} alt={c.title} loading="lazy" width="800" height="520" /></div>
        <div class="card-body">
          <span class="tag">{c.tag}</span>
          <h3>{c.title}</h3>
          <p>{c.desc}</p>
          <span class="card-go">바로 계산하기 →</span>
        </div>
      </a>
    ))}
  </div>

  <section class="article nl-banner">
    <h2>📬 새 지원금 알림 뉴스레터</h2>
    <p>새로 발표되는 정부 지원금·소비쿠폰 중 내 소득 구간에 해당되는 것만 매주 이메일로 받아보세요. 구독은 무료이며 언제든 수신거부할 수 있습니다.</p>
    <p><a class="gov-link" href={u("/welfare/#newsletter")}>뉴스레터 구독하기 →</a></p>
  </section>

  <section class="article">
    <h2>계산기는 어떻게 만드나요?</h2>
    <ul>
      <li><strong>공식 출처 기준:</strong> 국세청 세율표, 국민연금공단·국민건강보험공단 고시 요율, 고용노동부 제도 안내를 기준으로 계산 로직을 작성합니다.</li>
      <li><strong>검증된 계산:</strong> 모든 계산식은 단위 테스트로 검증되며, 요율 변경 시 업데이트 내역을 페이지에 명시합니다.</li>
      <li><strong>추정치 안내:</strong> 개인별 공제 항목과 특례는 무수히 달라질 수 있어 결과는 참고용 추정치로 제공합니다.</li>
    </ul>
    <h2>곧 추가될 계산기</h2>
    <p>{upcoming.join(' · ')}</p>
  </section>
</BaseLayout>
