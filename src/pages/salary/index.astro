---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { u } from '../../lib/paths.js';
import Faq from '../../components/Faq.astro';
import GovSupport from '../../components/GovSupport.astro';
import AdSlot from '../../components/AdSlot.astro';
import { AD_SLOTS } from '../../lib/ads.js';
import { faqJsonLd, pageUrl } from '../../lib/seo.js';

const faqs = [
  {
    q: '실제 급여명세서 금액과 왜 조금 다른가요?',
    a: '이 계산기는 연간 세액을 12개월로 나눈 추정치입니다. 실제 월급에서는 간이세액표 기준으로 원천징수되고, 국민연금도 신고된 기준소득월액(천원 미만 버림) 기준으로 계산되기 때문에 수천 원 차이가 날 수 있습니다.',
  },
  {
    q: '상여금은 포함되나요?',
    a: '입력한 연봉에 상여금이 포함되어 있다고 가정합니다. 상여금이 별도라면 연봉에 합산해서 입력하세요. 상여금의 4대보험·세금 처리 시점이 다를 수 있어 정확한 월별 실수령액과는 차이가 날 수 있습니다.',
  },
  {
    q: '2026년에 바뀐 게 뭔가요?',
    a: '국민연금 보험료율이 9%에서 9.5%로 올라 근로자 부담이 4.5%에서 4.75%가 됐고, 건강보험료율도 7.09%에서 7.19%로 인상됐습니다(근로자 부담 3.595%). 월급 300만원 기준으로 월 약 9천 원가량 공제가 늘었습니다.',
  },
  {
    q: '비과세액이 뭔가요?',
    a: '세금이 붙지 않는 급여 항목입니다. 대표적으로 식대(월 20만원 한도), 자가운전보조금(월 20만원 한도), 출산·보육수당(월 20만원 한도) 등이 있습니다. 4대보험도 비과세액을 제외한 금액에 부과됩니다.',
  },
  {
    q: '프리랜서도 이 계산기를 써도 되나요?',
    a: '아니요. 프리랜서·사업소득자는 4대보험이 아닌 3.3% 원천징수 방식이 적용됩니다. 프리랜서 3.3% 계산기를 이용하세요.',
  },
];
---
<BaseLayout
  title="2026년 연봉 실수령액 계산기"
  description="2026년 최신 요율(국민연금 4.75%, 건강보험 3.595%)로 연봉 실수령액을 계산하세요. 4대보험과 소득세 공제 내역을 한눈에 보여줍니다."
  keywords="2026 연봉 실수령액, 월급 실수령액 계산기, 4대보험 계산, 연봉 5000 실수령액"
  path="/salary/"
  ogImage="/images/card-salary.webp"
  jsonLd={faqJsonLd(faqs, pageUrl("/salary/"))}
>
  <p class="breadcrumb"><a href={u("/")}>홈</a> &gt; 연봉 실수령액 계산기</p>
  <h1 class="page-title">2026년 연봉 실수령액 계산기</h1>
  <p class="page-desc">세전 연봉을 입력하면 4대보험과 세금을 뺀 월 실수령액을 계산해 드립니다.</p>
  <p class="updated">2026년 요율 적용 · 최종 업데이트 2026-09-28</p>

  <section class="calc">
    <h2>🧮 계산하기</h2>
    <div class="field">
      <label for="annual">세전 연봉 (만원)</label>
      <input id="annual" type="number" value="5000" min="0" />
      <div class="hint">상여금 포함 연간 총액 기준</div>
    </div>
    <div class="field">
      <label for="nontax">월 비과세액 (만원)</label>
      <input id="nontax" type="number" value="20" min="0" />
      <div class="hint">식대 등, 보통 월 20만원</div>
    </div>
    <div class="field">
      <label for="dependents">부양가족 수 (본인 포함)</label>
      <input id="dependents" type="number" value="1" min="1" />
    </div>
    <button class="btn" id="calc-btn">실수령액 계산하기</button>

    <div class="result" id="result">
      <div>월 실수령액 (추정)</div>
      <div class="big" id="r-net">-</div>
      <table>
        <tr><th>항목</th><th>금액 (월)</th></tr>
        <tr><td>세전 월급</td><td id="r-monthly">-</td></tr>
        <tr><td>국민연금 (4.75%)</td><td id="r-pension">-</td></tr>
        <tr><td>건강보험 (3.595%)</td><td id="r-health">-</td></tr>
        <tr><td>장기요양보험</td><td id="r-ltc">-</td></tr>
        <tr><td>고용보험 (0.9%)</td><td id="r-employment">-</td></tr>
        <tr><td>소득세 + 지방소득세</td><td id="r-tax">-</td></tr>
      </table>
      <p class="note">연간 세액을 12로 나눈 추정치로, 실제 월 원천징수액(간이세액표 기준)과 다를 수 있습니다.</p>
    </div>
  </section>

  <AdSlot slotId={AD_SLOTS.RESULT_BOTTOM} />

  <script>
    import { calcSalary } from '../../lib/salary.js';
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => Math.round(n).toLocaleString('ko-KR') + '원';
    const num = (id) => parseFloat($(id).value.replace(/,/g, '')) || 0;
    $('calc-btn').addEventListener('click', () => {
      const r = calcSalary({
        annualSalary: num('annual') * 10000,
        nonTaxableMonthly: num('nontax') * 10000,
        dependents: Math.max(1, Math.floor(num('dependents'))),
      });
      $('r-net').textContent = fmt(r.netMonthly);
      $('r-monthly').textContent = fmt(r.monthly);
      $('r-pension').textContent = fmt(r.pension);
      $('r-health').textContent = fmt(r.health);
      $('r-ltc').textContent = fmt(r.longTermCare);
      $('r-employment').textContent = fmt(r.employment);
      $('r-tax').textContent = fmt(r.taxMonthly);
      $('result').classList.add('show');
    });
  </script>

  <section class="article">
    <h2>계산 방법</h2>
    <p>월 실수령액 = 세전 월급 − 4대보험 − (소득세 + 지방소득세). 2026년 기준 요율은 다음과 같습니다.</p>
    <table class="rate">
      <tr><th>항목</th><th>근로자 부담률</th><th>비고</th></tr>
      <tr><td>국민연금</td><td>4.75%</td><td>기준소득월액 상한 659만원 (2026.7~)</td></tr>
      <tr><td>건강보험</td><td>3.595%</td><td>전체 7.19%의 절반</td></tr>
      <tr><td>장기요양보험</td><td>건강보험료의 13.14%</td><td></td></tr>
      <tr><td>고용보험</td><td>0.9%</td><td></td></tr>
    </table>
    <p>소득세는 근로소득공제 → 인적공제(본인 포함 부양가족 1인당 150만원) 및 4대보험료 공제 → 과세표준에 기본세율(6~45%) 적용 → 근로소득세액공제 차감 순서로 추산하고, 12개월로 나눕니다. 지방소득세는 소득세의 10%입니다.</p>
    <h2>꼭 알아두세요</h2>
    <ul>
      <li>4대보험은 식대 등 비과세액을 제외한 보수월액에 부과됩니다.</li>
      <li>국민연금은 상한액(월 659만원)이 있어 고소득자의 부담이 제한됩니다.</li>
      <li>실제 월 원천징수는 간이세액표를 사용하므로 이 추정치와 수천 원 차이가 날 수 있습니다.</li>
    </ul>
  </section>

  <AdSlot slotId={AD_SLOTS.IN_CONTENT} />

  <Faq items={faqs} />

  <GovSupport page="salary" />

  <section class="related">
    <h2>관련 계산기</h2>
    <div class="grid">
      <a class="card" href={u("/severance/")}><h3>퇴직금 계산기</h3><p>세후 실수령액까지 계산</p></a>
      <a class="card" href={u("/parttime-severance/")}><h3>알바 퇴직금 계산기</h3><p>시급제·주휴수당 포함</p></a>
      <a class="card" href={u("/freelancer/")}><h3>프리랜서 3.3% 계산기</h3><p>원천징수 후 실수령액</p></a>
      <a class="card" href={u("/yearend-tax/")}><h3>연말정산 미리보기 계산기</h3><p>환급 예상액 미리 계산</p></a>
      <a class="card" href={u("/dsr/")}><h3>DSR 계산기</h3><p>대출 가능 여부 가늠</p></a>
    </div>
  </section>
</BaseLayout>
