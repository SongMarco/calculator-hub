---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import GovSupport from '../../components/GovSupport.astro';
import { faqJsonLd, SITE_URL } from '../../lib/seo.js';

const faqs = [
  {
    q: '퇴직금 세금이 생각보다 적은데 맞나요?',
    a: '맞습니다. 퇴직소득세는 근속연수공제와 환산급여공제가 크고, 연평균과세(세액을 근속연수로 나누는 방식)가 적용되어 일반 소득세보다 부담이 훨씬 작습니다. 장기 근속할수록 실효세율이 낮아집니다.',
  },
  {
    q: '알바도 퇴직금을 받을 수 있나요?',
    a: '주 15시간 이상, 계속근로 1년 이상이면 아르바이트·계약직도 퇴직금을 받을 수 있습니다. 4주 평균으로 계산하며, 1년 미만이면 법정 퇴직금은 없습니다.',
  },
  {
    q: '1년 미만 근무하면 퇴직금이 없나요?',
    a: '법정 퇴직금은 계속근로기간 1년 이상부터 발생합니다. 다만 회사 취업규칙이나 단체협약에서 더 유리하게 정했다면 그에 따릅니다.',
  },
  {
    q: '퇴직금 중간정산이 뭔가요?',
    a: '재직 중에 퇴직금을 미리 받는 제도로, 무주택자 주택구입·전세, 6개월 이상 요양, 파산 등 법정 사유가 있을 때만 가능합니다. 중간정산 후 근속연수는 새로 계산됩니다.',
  },
  {
    q: '언제까지 받을 수 있나요?',
    a: '사용자는 퇴직일로부터 14일 이내에 퇴직금을 지급해야 합니다. 당사자 합의로 연장할 수 있으며, 지연 시 연 20%의 지연이자가 붙습니다.',
  },
];
---
<BaseLayout
  title="퇴직금 계산기 (세후 실수령액)"
  description="평균임금과 근속연수로 퇴직금을 계산하고 퇴직소득세를 뗀 세후 실수령액까지 확인하세요. 상여금·연차수당 반영 가능."
  keywords="퇴직금 계산기, 퇴직금 세후, 퇴직소득세 계산, 평균임금 계산"
  path="/severance/"
  ogImage="https://calculator-hub-songmarcos-projects.vercel.app/images/card-severance.webp"
  jsonLd={faqJsonLd(faqs, `${SITE_URL}/severance/`)}
>
  <p class="breadcrumb"><a href="/calculator-hub/">홈</a> &gt; 퇴직금 계산기</p>
  <h1 class="page-title">퇴직금 계산기 (세후 실수령액)</h1>
  <p class="page-desc">퇴직 전 3개월 임금과 근속기간을 입력하면 세전 퇴직금과 세후 실수령액을 계산해 드립니다.</p>
  <p class="updated">2026년 세법 기준 · 최종 업데이트 2026-09-28</p>

  <section class="calc">
    <h2>🧮 계산하기</h2>
    <div class="field">
      <label for="wages">퇴직 전 3개월 임금총액 (만원)</label>
      <input id="wages" type="number" value="900" min="0" />
      <div class="hint">세전, 상여금 제외</div>
    </div>
    <div class="field">
      <label for="days">3개월 총일수 (일)</label>
      <input id="days" type="number" value="92" min="1" />
      <div class="hint">달력일수 (예: 1~3월은 90~92일)</div>
    </div>
    <div class="field">
      <label for="bonus">연간 상여금 총액 (만원)</label>
      <input id="bonus" type="number" value="0" min="0" />
    </div>
    <div class="field">
      <label for="leave">미사용 연차수당 (만원)</label>
      <input id="leave" type="number" value="0" min="0" />
    </div>
    <div class="field">
      <label for="years">재직기간 (년)</label>
      <input id="years" type="number" value="3" min="0" />
    </div>
    <div class="field">
      <label for="months">재직기간 (개월, 년 제외)</label>
      <input id="months" type="number" value="0" min="0" max="11" />
    </div>
    <button class="btn" id="calc-btn">퇴직금 계산하기</button>

    <div class="result" id="result">
      <div>세후 실수령액 (추정)</div>
      <div class="big" id="r-net">-</div>
      <table>
        <tr><th>항목</th><th>금액</th></tr>
        <tr><td>1일 평균임금</td><td id="r-avg">-</td></tr>
        <tr><td>세전 퇴직금</td><td id="r-gross">-</td></tr>
        <tr><td>퇴직소득세 + 지방소득세</td><td id="r-tax">-</td></tr>
      </table>
      <p class="note">회사 취업규칙·단체협약이 법정 기준보다 유리하면 그 기준이 우선합니다.</p>
    </div>
  </section>

  <script>
    import { calcSeverance } from '../../lib/severance.js';
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => Math.round(n).toLocaleString('ko-KR') + '원';
    const num = (id) => parseFloat($(id).value.replace(/,/g, '')) || 0;
    $('calc-btn').addEventListener('click', () => {
      const tenureDays = Math.floor(num('years')) * 365 + Math.floor(num('months')) * 30;
      const r = calcSeverance({
        wages3mo: num('wages') * 10000,
        days3mo: Math.max(1, Math.floor(num('days'))),
        bonusAnnual: num('bonus') * 10000,
        leavePay: num('leave') * 10000,
        tenureDays,
      });
      $('r-net').textContent = fmt(r.net);
      $('r-avg').textContent = fmt(r.avgDaily);
      $('r-gross').textContent = fmt(r.gross);
      $('r-tax').textContent = fmt(r.totalTax);
      $('result').classList.add('show');
    });
  </script>

  <section class="article">
    <h2>계산 방법</h2>
    <p><strong>1일 평균임금</strong> = (퇴직 전 3개월 임금총액 + 연간상여금×3/12 + 연차수당×3/12) ÷ 3개월 총일수</p>
    <p><strong>퇴직금(세전)</strong> = 1일 평균임금 × 30일 × (재직일수 ÷ 365)</p>
    <p>퇴직소득세는 <strong>연평균과세</strong>로 계산됩니다. 근속연수공제(5년 이하 연 100만원 등)를 뺀 뒤 환산급여(= 과세대상 ÷ 근속연수 × 12)에 환산급여공제를 적용하고, 기본세율로 산출한 세액을 다시 12로 나눠 근속연수를 곱합니다. 지방소득세 10%가 추가됩니다.</p>
    <table class="rate">
      <tr><th>근속연수</th><th>근속연수공제</th></tr>
      <tr><td>5년 이하</td><td>100만원 × 근속연수</td></tr>
      <tr><td>5년 초과 10년 이하</td><td>500만원 + 200만원 × (근속연수 − 5)</td></tr>
      <tr><td>10년 초과 20년 이하</td><td>1,500만원 + 300만원 × (근속연수 − 10)</td></tr>
      <tr><td>20년 초과</td><td>4,500만원 + 500만원 × (근속연수 − 20)</td></tr>
    </table>
    <h2>꼭 알아두세요</h2>
    <ul>
      <li>퇴직금은 퇴직일로부터 <strong>14일 이내</strong>에 지급되어야 합니다.</li>
      <li>퇴직연금(DB·DC형) 가입자는 회사가 적립한 퇴직연금으로 갈음할 수 있습니다.</li>
      <li>퇴직소득은 종합소득 합산이 아닌 <strong>분류과세</strong>라 연말정산과 별개입니다.</li>
    </ul>
  </section>

  <Faq items={faqs} />

  <GovSupport page="severance" />

  <section class="related">
    <h2>관련 계산기</h2>
    <div class="grid">
      <a class="card" href="/calculator-hub/salary/"><h3>연봉 실수령액 계산기</h3><p>2026년 최신 요율 반영</p></a>
      <a class="card" href="/calculator-hub/parental/"><h3>육아휴직 급여 계산기</h3><p>휴직 기간별 예상 급여</p></a>
      <a class="card" href="/calculator-hub/freelancer/"><h3>프리랜서 3.3% 계산기</h3><p>원천징수 후 실수령액</p></a>
    </div>
  </section>
</BaseLayout>
