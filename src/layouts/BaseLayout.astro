---
interface Props {
  title: string;
  description: string;
  keywords?: string;
  path?: string;
  jsonLd?: Record<string, unknown>;
  ogImage?: string;
  noindex?: boolean;
}
import { u } from '../lib/paths.js';
const { title, description, keywords = '', path = '/', jsonLd, noindex = false } = Astro.props;
const siteName = '계산기허브';
const fullTitle = `${title} | ${siteName}`;
// 정규 site URL: astro.config.mjs의 site (Vercel 빌드 → https://calc.choronglight.com, GH Pages 빌드 → songmarco.github.io/calculator-hub)
// GH Pages의 site에는 subpath(/calculator-hub)가 이미 포함되므로, 절대 URL을 만들 때는
// u()로 base를 중복 추가하지 않는다. path/ogImage prop은 base 없는 라우트 경로('/salary/', '/images/...') 기준.
const SITE = (Astro.site ? Astro.site.href : 'https://calc.choronglight.com/').replace(/\/$/, '');
const { ogImage = '/images/og-hub.webp' } = Astro.props;
// ogImage는 상대 경로로 받아서 site 기준 절대 URL로 변환 (http로 시작하면 그대로 사용)
const ogImageAbs = ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage}`;
const ogUrlAbs = `${SITE}${path}`;
// BreadcrumbList 구조화 데이터: 홈 > 현재 페이지 (루트·404 제외)
const breadcrumbLd = (path && path !== '/' && path !== '/404/')
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '홈', item: SITE },
        { '@type': 'ListItem', position: 2, name: title, item: ogUrlAbs },
      ],
    }
  : null;
const jsonLdList = [jsonLd, breadcrumbLd].filter(Boolean);
const jsonLdOut =
  jsonLdList.length > 1
    ? { '@context': 'https://schema.org', '@graph': jsonLdList }
    : jsonLdList[0] || null;
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageAbs} />
  <meta property="og:url" content={ogUrlAbs} />
  <link rel="canonical" href={ogUrlAbs} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImageAbs} />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
  {jsonLdOut && <script type="application/ld+json" set:html={JSON.stringify(jsonLdOut)} />}
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧮</text></svg>" />
  <!-- Google tag (GA4) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-9X0RGDJTGV"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-9X0RGDJTGV');
  </script>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8849084322770219" crossorigin="anonymous"></script>
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href={u('/')}><span class="brand-mark">🧮</span>계산기<span>허브</span></a>
      <nav class="nav">
        <a href={u('/salary/')}>연봉 실수령액</a>
        <a href={u('/severance/')}>퇴직금</a>
        <a href={u('/monthly-rent/')}>월세 세액공제</a>
        <a href={u('/irp/')}>IRP 세금비교</a>
        <a href={u('/hourly-wage/')}>주휴 시급</a>
        <a href={u('/dsr/')}>DSR</a>
        <a href={u('/welfare/')}>정부 지원금</a>
      </nav>
    </div>
  </header>
  <main class="wrap">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <p class="foot-brand">🧮 계산기허브</p>
      <div class="disclaimer">
        ⚠️ 이 사이트의 모든 계산 결과는 2026년 기준 요율을 적용한 <strong>참고용 추정치</strong>입니다.
        실제 금액은 개인별 공제 항목, 회사 규정, 금융기관 심사 기준에 따라 달라질 수 있습니다.
        중요한 의사결정 전에는 국세청·국민연금공단·고용노동부 등 공식 기관의 계산기나 전문가 상담을 병행하세요.
      </div>
      <p>© 2026 계산기허브. 돈 계산, 쉽게.</p>
    </div>
  </footer>
</body>
</html>
